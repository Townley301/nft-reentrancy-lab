{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-rule-spec.schema.json",
  "title": "Natural-language research rule audit specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "localOnly", "source", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "localOnly": { "const": true },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "file"],
      "properties": {
        "kind": { "const": "natural-language" },
        "title": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "expected", "scope", "assumptions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "statement": { "type": "string", "minLength": 1 },
          "expected": { "const": "preserve" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contracts", "functions", "states"],
            "properties": {
              "contracts": { "$ref": "#/$defs/identifiers" },
              "functions": { "$ref": "#/$defs/identifiers" },
              "states": { "$ref": "#/$defs/identifiers" }
            }
          },
          "dynamicTemplate": {
            "enum": ["one-time-mint", "collateral-coverage", "funded-value"]
          },
          "assumptions": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "identifiers": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
    }
  }
}
