{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-spec.schema.json",
  "title": "Bounded local callback adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "dataset", "description", "callbackStandard", "binding", "parameterBounds", "deployments", "setup", "entry", "observations", "assertion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "dataset": { "enum": ["development", "holdout"] },
    "description": { "type": "string", "minLength": 1 },
    "callbackStandard": { "enum": ["ERC721", "ERC1155"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "variants"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "variants": { "$ref": "#/$defs/variants" }
      }
    },
    "parameterBounds": {
      "type": "object",
      "maxProperties": 12,
      "additionalProperties": { "$ref": "#/$defs/bounds" }
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/deployment" }
    },
    "setup": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/call" }
    },
    "entry": { "$ref": "#/$defs/call" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/observation" }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "left", "right"],
      "properties": {
        "operator": { "enum": ["lte", "gte", "eq"] },
        "left": { "$ref": "#/$defs/expression" },
        "right": { "$ref": "#/$defs/expression" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "outerFunction", "reentryFunction"],
      "properties": {
        "contract": { "$ref": "#/$defs/identifier" },
        "outerFunction": { "$ref": "#/$defs/identifier" },
        "reentryFunction": { "$ref": "#/$defs/identifier" }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerableContract", "fixedContract"],
      "properties": {
        "vulnerableContract": { "$ref": "#/$defs/identifier" },
        "fixedContract": { "$ref": "#/$defs/identifier" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "variantContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerable", "fixed"],
      "properties": {
        "vulnerable": { "$ref": "#/$defs/identifier" },
        "fixed": { "$ref": "#/$defs/identifier" }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "uint" }, "value": { "type": "string", "pattern": "^[0-9]+$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "bool" }, "value": { "type": "boolean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": { "kind": { "const": "contract" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": { "kind": { "const": "param" }, "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": { "kind": { "const": "observation" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "left", "right"],
          "properties": {
            "kind": { "enum": ["add", "sub", "mul"] },
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "constructorArgs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "contract": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "$ref": "#/$defs/variantContract" }] },
        "constructorArgs": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "function", "args"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "function": { "$ref": "#/$defs/identifier" },
        "args": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/expression" } },
        "allowRevert": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["vulnerable", "fixed"],
              "properties": { "vulnerable": { "type": "boolean" }, "fixed": { "type": "boolean" } }
            }
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "function", "args"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "function": { "$ref": "#/$defs/identifier" },
        "args": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/expression" } }
      }
    }
  }
}
