{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "callback-rules.schema.json",
  "title": "Local callback business rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lab", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "localOnly", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "localOnly": { "const": true },
        "description": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerable", "fixed"],
      "properties": {
        "vulnerable": { "enum": ["preserve", "violate"] },
        "fixed": { "enum": ["preserve", "violate"] }
      }
    },
    "ruleBase": {
      "type": "object",
      "required": ["id", "description", "template", "parameters", "expectations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "description": { "type": "string", "minLength": 1 },
        "expectations": { "$ref": "#/$defs/expectations" }
      }
    },
    "rule": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/ruleBase" },
            {
              "additionalProperties": false,
              "properties": {
                "id": true,
                "description": true,
                "expectations": true,
                "template": { "const": "one-time-mint" },
                "parameters": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": { "type": "object", "maxProperties": 0 }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ruleBase" },
            {
              "additionalProperties": false,
              "properties": {
                "id": true,
                "description": true,
                "expectations": true,
                "template": { "const": "collateral-coverage" },
                "parameters": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["borrowAmount"],
                    "properties": {
                      "borrowAmount": { "type": "integer", "minimum": 11, "maximum": 20 }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ruleBase" },
            {
              "additionalProperties": false,
              "properties": {
                "id": true,
                "description": true,
                "expectations": true,
                "template": { "const": "funded-value" },
                "parameters": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["outerQuantity", "depositPerUnit", "additionalQuantity"],
                    "properties": {
                      "outerQuantity": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "depositPerUnit": { "type": "integer", "minimum": 1, "maximum": 5 },
                      "additionalQuantity": { "type": "integer", "minimum": 1, "maximum": 3 }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
