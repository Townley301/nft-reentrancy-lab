{
  "schemaVersion": 1,
  "lab": {
    "name": "NFT callback business-rule lessons",
    "localOnly": true,
    "description": "Research rules for bounded callback simulations on a temporary Hardhat chain."
  },
  "rules": [
    {
      "id": "one-time-mint-right",
      "description": "One address must not receive more than one NFT from a one-time mint right.",
      "template": "one-time-mint",
      "parameters": [{}],
      "expectations": {
        "vulnerable": "violate",
        "fixed": "preserve"
      }
    },
    {
      "id": "collateral-covers-debt",
      "description": "Outstanding debt must not exceed the remaining NFT collateral capacity.",
      "template": "collateral-coverage",
      "parameters": [
        { "borrowAmount": 11 },
        { "borrowAmount": 15 },
        { "borrowAmount": 19 }
      ],
      "expectations": {
        "vulnerable": "violate",
        "fixed": "preserve"
      }
    },
    {
      "id": "payout-within-funded-value",
      "description": "The final FNFT payout must not exceed the value funded by the caller.",
      "template": "funded-value",
      "parameters": [
        { "outerQuantity": 3, "depositPerUnit": 1, "additionalQuantity": 1 },
        { "outerQuantity": 5, "depositPerUnit": 2, "additionalQuantity": 2 },
        { "outerQuantity": 8, "depositPerUnit": 3, "additionalQuantity": 2 }
      ],
      "expectations": {
        "vulnerable": "violate",
        "fixed": "preserve"
      }
    }
  ]
}
